# Razorpay Standard Checkout
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Browser-safe Razorpay key for Next.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Avenlo payment configuration
AVENLO_PAYMENT_PROVIDER=razorpay
# Canonical browser origin. Set the actual HTTPS domain in Production.
# Account-erasure origin checks use this value behind the hosting proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after the account-erasure migration and retention review are complete.
ENABLE_CANDIDATE_ACCOUNT_ERASURE=false

# Enable apex-to-portal redirects only AFTER exact domains, HTTPS, Auth redirects
# and the reviewed application deployment are verified. Sessions remain host-only.
AVENLO_PORTALS_ENABLED=false
# Server-only, operator-provisioned tenant assignments. Do not use NEXT_PUBLIC_.
# Shape: {"assigned-slug":{"companyId":"<company UUID>","contractActive":true,"activeHiring":true}}
# Keep empty until a real long-term company contract and active hiring are confirmed.
AVENLO_COMPANY_TENANTS={}
