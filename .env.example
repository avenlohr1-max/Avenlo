# Razorpay Standard Checkout
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Browser-safe Razorpay key for Next.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Avenlo payment configuration
AVENLO_PAYMENT_PROVIDER=razorpay
# Canonical browser origin. Set the actual HTTPS domain in Production.
# Account-erasure origin checks use this value behind the hosting proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after the account-erasure migration and retention review are complete.
ENABLE_CANDIDATE_ACCOUNT_ERASURE=false
